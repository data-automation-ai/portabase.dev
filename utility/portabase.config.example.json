{
  "version": 2,
  "projectRef": "abcdefghijklmnopqrst",
  "backupDirectory": "./portabase-capsules",
  "statusDirectory": "./portabase-status",
  "provider": {
    "type": "google-drive",
    "remote": "gdrive",
    "path": "/PortaBase"
  },
  "capture": {
    "database": true,
    "storage": true,
    "functions": true
  },
  "encryption": {
    "passphraseEnv": "PORTABASE_ENCRYPTION_PASSPHRASE"
  },
  "retention": {
    "keepLast": 30,
    "pruneAfterBackup": false
  },
  "schedule": {
    "everyHours": 6
  },
  "alerts": {
    "webhookEnv": "PORTABASE_ALERT_WEBHOOK_URL"
  }
}
