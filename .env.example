# Server-side Netlify Function values. Never prefix secrets with VITE_ unless they are public.
# Copy to Netlify env or a local .env — never commit real tokens.

# --- Supabase Auth (Portabase Cloud identity — hosted only) ---
SUPABASE_URL=https://ekklokrukxmqlahtonnc.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional browser build-time (publishable only — never service role):
# VITE_SUPABASE_URL=https://ekklokrukxmqlahtonnc.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Auth providers (hosted Supabase Auth — not the live business source) ---
# Enable Email + Google + GitHub on the Portabase Cloud Auth project.
# Do not write control-plane rows to ekklokrukxmqlahtonnc.
# Redirect URLs must include:
#   https://portabase.dev/auth/callback
#   http://localhost:5173/auth/callback
# Put the Google Cloud OAuth client on the Supabase provider form — Portabase
# does not store the Google client secret. Placeholders only:
# GOOGLE_OAUTH_CLIENT_ID=your-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
# Optional GIS (not used at launch; Supabase OAuth is the path):
# VITE_GOOGLE_CLIENT_ID=
# GitHub OAuth client goes on Supabase Auth → Providers → GitHub (not Netlify):
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# --- Cloud control-plane store (hosted Supabase primary + one sqlite replica) ---
# Never set the URL to ekklokrukxmqlahtonnc (live business source, not a write dest).
# PORTABASE_CLOUD_SUPABASE_URL=https://<portabase-cloud-project>.supabase.co
# PORTABASE_CLOUD_SUPABASE_SERVICE_KEY=
# PORTABASE_CLOUD_SQLITE_PATH=/var/lib/portabase-cloud/control-plane.db

# --- Cloud Runner (container) ---
# PORTABASE_RUNNER_SUBSCRIBER_ID=
# PORTABASE_RUNNER_REGION=us-east-1

# --- Square billing (never commit live secrets) ---
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# LIVE (preferred) vs TEST: omit or set production for live Square.
# TEST only: SQUARE_ENVIRONMENT=sandbox  (alias SQUARE_ENV=sandbox)
SQUARE_ENVIRONMENT=production
# Pin catalog plan variations after you create them in Square:
# SQUARE_CLOUD_PLAN_VARIATION_ID_7=        # $7/mo · 1 GB
# SQUARE_CLOUD_PLAN_VARIATION_ID=          # $17/mo · 10 GB (default)
# SQUARE_CLOUD_PLAN_VARIATION_ID_17=       # optional alias for $17
# SQUARE_CLOUD_PLAN_VARIATION_ID_37=       # $37/mo · 100 GB
# Extra transfers add-on (up to 3 / 24h): +$3 on $7, +$5 on $17 / $37.
# EXTRA_TRANSFERS_ADDON_MONTHLY_USD=        # optional workspace-wide override
# VITE_EXTRA_TRANSFERS_ADDON_MONTHLY_USD=
# SQUARE_EXTRA_TRANSFERS_ADDON_VARIATION_ID_7=REPLACE_WITH_SQUARE_CATALOG_ID
# SQUARE_EXTRA_TRANSFERS_ADDON_VARIATION_ID_17=REPLACE_WITH_SQUARE_CATALOG_ID
# SQUARE_EXTRA_TRANSFERS_ADDON_VARIATION_ID_37=REPLACE_WITH_SQUARE_CATALOG_ID
# SQUARE_EXTRA_TRANSFERS_ADDON_VARIATION_ID=  # fallback pin

PORTABASE_LICENSE_PRIVATE_KEY=
# Netlify fallback for multiline PEM values; server-side only.
PORTABASE_LICENSE_PRIVATE_KEY_BASE64=

# Public canonical URL used for Square redirects and webhook verification.
PORTABASE_SITE_URL=https://portabase.dev
SECRETS_BUNDLE_ID=secrets-bundle
