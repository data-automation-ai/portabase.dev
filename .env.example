# Server-side Netlify Function values. Never prefix secrets with VITE_ unless they are public.

# --- Supabase Auth (Portabase Cloud identity — hosted only) ---
SUPABASE_URL=https://ekklokrukxmqlahtonnc.supabase.co
SUPABASE_ANON_KEY=
# Optional browser build-time (publishable only — never service role):
# VITE_SUPABASE_URL=https://ekklokrukxmqlahtonnc.supabase.co
# VITE_SUPABASE_ANON_KEY=

SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_ENV=production
# Optional: pin Square catalog plan variation after first auto-create
# SQUARE_CLOUD_PLAN_VARIATION_ID=
PORTABASE_LICENSE_PRIVATE_KEY=
# Netlify fallback for multiline PEM values; server-side only.
PORTABASE_LICENSE_PRIVATE_KEY_BASE64=

# Public canonical URL used for Square redirects and webhook verification.
PORTABASE_SITE_URL=https://portabase.dev
SECRETS_BUNDLE_ID=secrets-bundle
