{
  "name": "portabase",
  "private": true,
  "version": "0.4.0",
  "description": "Open-source Supabase Escape — encrypted customer-owned recovery capsules (database, Auth, Storage bytes, Edge Functions). Optional Portabase Cloud for GUI and alerts.",
  "homepage": "https://portabase.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/data-automation-ai/portabase.dev.git"
  },
  "bugs": {
    "url": "https://github.com/data-automation-ai/portabase.dev/issues",
    "email": "escape@portabase.dev"
  },
  "keywords": [
    "supabase",
    "backup",
    "recovery",
    "escape",
    "disaster-recovery",
    "open-source",
    "aes-256-gcm"
  ],
  "author": {
    "name": "DataAutomation.ai, LLC",
    "email": "escape@portabase.dev"
  },
  "desktopName": "Portabase",
  "type": "module",
  "main": "desktop/main.cjs",
  "bin": {
    "portabase": "utility/portabase.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run build",
    "portabase": "node utility/portabase.mjs",
    "trial": "node utility/portabase.mjs backup --trial",
    "test": "node --test utility/*.test.mjs tests/*.test.mjs tests/*.test.cjs src/console/data/*.test.mjs",
    "desktop": "electron .",
    "desktop:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-desktop-tools.ps1 && electron-builder --win nsis",
    "desktop:linux": "node -e \"console.error('Launch desktop is Windows 11 only. Use the open-source CLI on Linux.'); process.exit(1)\"",
    "desktop:mac": "node -e \"console.error('Launch desktop is Windows 11 only — do not build for Mac. Use the open-source CLI on macOS if needed.'); process.exit(1)\""
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "^3.1102.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1102.0",
    "@aws-sdk/client-secrets-manager": "^3.1085.0",
    "@aws-sdk/client-sts": "^3.1102.0",
    "@netlify/blobs": "^10.7.9",
    "@supabase/supabase-js": "^2.112.0",
    "aws-jwt-verify": "^5.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "square": "^44.2.0",
    "supabase": "2.109.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.1"
  },
  "build": {
    "appId": "dev.portabase.desktop",
    "productName": "Portabase",
    "asar": true,
    "asarUnpack": [
      "utility/**",
      "node_modules/@supabase/**"
    ],
    "files": [
      "desktop/**",
      "utility/**",
      "package.json",
      "!node_modules/**",
      "node_modules/@supabase/**"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "desktop/vendor",
        "to": "tools"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Portabase-Setup-${version}-unsigned.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Portabase",
      "uninstallDisplayName": "Portabase"
    }
  },
  "license": "Apache-2.0",
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.2"
  }
}
